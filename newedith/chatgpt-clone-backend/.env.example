# Copy this file to ".env" and fill in real values below.

# Get a free key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your-gemini-key-here

# Any random long string — used to secure login sessions.
# You can literally type random characters here, just keep it secret.
SESSION_SECRET=change-this-to-some-random-long-string

PORT=3000
